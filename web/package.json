{
  "name": "champs-manager-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "wasm:build": "wasm-pack build ../crates/champs-core --target web --out-dir ../../web/src/wasm_pkg",
    "test": "node --test tests/*.test.mjs",
    "test:career": "node --experimental-strip-types --test tests/careerEconomy.test.mjs",
    "test:transfers": "node --experimental-strip-types --test tests/classicTransfersAndEconomy.test.mjs",
    "sim:economy": "node --experimental-strip-types scripts/simulate-economy.mjs",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "test:match": "node --experimental-strip-types --test tests/matchCycle.test.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.7.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wasm-pack": "^0.15.0"
  }
}
